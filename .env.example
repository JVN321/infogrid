# ==============================================================================
# InfoGrid Environment Variables Configuration (.env.example)
# Duplicate this file to '.env' and fill in your actual credentials.
# ==============================================================================

# 1. Database Connection (PostgreSQL / Supabase)
# Pooled connection string (used by Prisma Client runtime queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (used by Prisma migrations & db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Admin Dashboard Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_secure_password_change_me"

# 3. External News API (https://newsapi.org)
NEWS_API_KEY="your_news_api_key_here"

# 4. Convex MITS Media Club Events API
CONVEX_EVENTS_API_URL="https://convexapi.mitsmediaclub.com/api/events"
CONVEX_EVENTS_AUTH_TOKEN="grid_events-OLCc90BjG8dwc291Po0ogbUvcbSLEGLb"

# 5. Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="infogrid-campus-assets"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
